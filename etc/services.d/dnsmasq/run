#!/usr/bin/with-contenv bash

if [ -z ${CONTAINER_IP} ]; then
    # Prefer a real NIC's globally-scoped IPv4 address, skipping
    # VirtualBox's default NAT subnet (10.0.2.0/24). This matters on a
    # Vagrant VM with both a NAT adapter and a bridged adapter: both get an
    # equal-metric default route, so which one is reachable via `ip route
    # get` depends on DHCP lease timing rather than anything deterministic,
    # and busybox's `ip route get` (used in this Alpine-based image) just
    # returns whichever default route happens to be first in the table
    # instead of asking the kernel to resolve the real route decision.
    CONTAINER_IP=$(ip -4 -o addr show scope global \
        | awk '$2 !~ /^(lo|docker|veth|br-|virbr|cni|flannel|tun|tap)/ && $4 !~ /^10\.0\.2\./ { split($4, a, "/"); print a[1]; exit }')

    if [ -z "${CONTAINER_IP}" ]; then
        # Fall back to the old behaviour, e.g. a plain Linux Docker host
        # with a single network interface
        CONTAINER_IP=$(ip route get to 1.1.1.1 | awk '/1.1.1.1/ { print $7}')
    fi
fi

# Start dnsmasq
dnsmasq --no-daemon --dhcp-range=${DHCP_RANGE_START},proxy \
    --dhcp-boot=tag:ipxe-bios,netboot.xyz.kpxe,,${CONTAINER_IP} \
    --dhcp-boot=tag:ipxe-efi,netboot.xyz.efi,,${CONTAINER_IP} \
    ${DNSMASQ_ARGS}
